/*
 * Forked from ZMK mainline's `corne` shield default keymap, with the
 * outer pinky column dropped on each side (TAB/BSPC and CTRL/' and
 * SHFT/ESC) to fit the 3x5+3 layout. 36 bindings per layer, in the same
 * row-major order as the five_column_transform map in dactyl_cygnus.dtsi.
 *
 * Base layer uses Colemak Mod-DH (matrix variant), not QWERTY.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        macros {
// Each taps the tmux prefix (ctrl+space) then releases it before tapping
// the window number -- tmux's prefix is a leader key, not a held chord.
                tmux_win1: tmux_win1 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp N1>; };
                tmux_win2: tmux_win2 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp N2>; };
                tmux_win3: tmux_win3 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp N3>; };
                tmux_win4: tmux_win4 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp N4>; };
                tmux_win5: tmux_win5 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp N5>; };
                tmux_win6: tmux_win6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp N6>; };
                tmux_win7: tmux_win7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp N7>; };
                tmux_win8: tmux_win8 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp N8>; };
                tmux_win9: tmux_win9 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp N9>; };
                tmux_win0: tmux_win0 { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp N0>; };
        };

        combos {
                compatible = "zmk,combos";
// Home row, right hand, positions 16+17 (N and E in the Colemak-DH
// default_layer). Tap together to switch to navigation_layer.
                combo_navigation_layer {
                        timeout-ms = <50>;
                        key-positions = <16 17>;
                        bindings = <&to 3>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------
// |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L  |  U  |  Y  |  ;   |
// |  A  |  R  |  S  |  T  |  G  |   |  M  |  N  |  E  |  I  |  O   |
// |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H  |  ,  |  .  |  /   |
//             | GUI |     | SPC |   | ENT | ALT | HOLD:CTRL |
// Right thumb outer key holds into control_layer (the layer hub) --
// everything else (symbols, navigation, media) is reached from there,
// or via the N+E combo for navigation directly.
                        bindings = <
   &kp Q &kp W &kp F &kp P &kp B     &kp J &kp L &kp U     &kp Y   &kp SEMI
   &kp A &kp R &kp S &kp T &kp G     &kp M &kp N &kp E     &kp I   &kp O
   &kp Z &kp X &kp C &kp D &kp V     &kp K &kp H &kp COMMA &kp DOT &kp FSLH
               &kp LGUI &trans &kp SPACE   &kp RET &kp RALT &mo 1
                        >;
                };

                control_layer {
// Held via the right thumb outer key -- this is the ONLY layer
// reached by holding; every other layer is a tap-and-switch (&to).
// Row 1 = numbers. Row 2 = arrows (right hand, starting one key in)
// + Page Up/Down under the left hand's middle/index fingers. Row 3:
// left hand is the layer hub -- while holding this key, tap one of
// these to permanently switch to that layer -- right hand is media
// transport + volume instead (no need to leave this layer just to
// tap play/pause or adjust volume).
// -----------------------------------------------------------------
// |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0   |
// |     |     | PGUP| PGDN|     |   |     | LFT | DWN |  UP | RGT  |
// | DEF | SYM | NAV | MED |     |   |PREV | PLAY|NEXT |VOL- |VOL+  |
//             | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp N1 &kp N2   &kp N3   &kp N4   &kp N5    &kp N6   &kp N7   &kp N8 &kp N9    &kp N0
   &trans &trans   &kp PG_UP &kp PG_DN &trans   &trans   &kp LEFT &kp DOWN &kp UP &kp RIGHT
   &to 0  &to 2    &to 3    &to 4    &trans    &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP
                    &kp LGUI &trans &kp SPACE   &kp RET &trans &kp RALT
                        >;
                };

                symbols_layer {
// One rule for the whole layer: home row = base symbol, bottom row =
// its Shift-variant, same column. (Top row already follows this same
// pattern relative to control_layer's number row -- including ( and ),
// which is why parens stay on the right instead of also splitting.)
//
// The two innermost columns (index fingers, either side of the split)
// are the exception: they're a dedicated open/close zone instead --
// left index = opening delimiter, right index = closing delimiter,
// row picks bracket vs brace. So [ and ], and { and }, each land one
// per hand instead of bunched on one side.
// -----------------------------------------------------------------
// |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )   |
// |  `  |  -  |  =  |  \  |  [  |   |  ]  |  ;  |  '  |  ,  |  .   |
// |  ~  |  _  |  +  |  |  |  {  |   |  }  |  :  |  "  |  <  |  >   |
//             | GUI | DEF | SPC |   | ENT | NAV | ALT |
                        bindings = <
   &kp EXCL  &kp AT    &kp HASH  &kp DLLR &kp PRCNT    &kp CARET &kp AMPS &kp ASTRK &kp LPAR   &kp RPAR
   &kp GRAVE &kp MINUS &kp EQUAL &kp BSLH &kp LBKT     &kp RBKT  &kp SEMI &kp SQT   &kp COMMA  &kp DOT
   &kp TILDE &kp UNDER &kp PLUS  &kp PIPE &kp LBRC     &kp RBRC  &kp COLON &kp DQT  &kp LS(COMMA) &kp LS(DOT)
                    &kp LGUI &to 0 &kp SPACE   &kp RET &to 3 &kp RALT
                        >;
                };

                navigation_layer {
// Hyprland window/workspace management. Entered via the combo below
// (tap N+E together); persists until you leave via a thumb key.
// -----------------------------------------------------------------
// |SUP+SFT+1|SUP+SFT+2|SUP+SFT+3|SUP+SFT+4|SUP+SFT+5| |SUP+SFT+6|SUP+SFT+7|SUP+SFT+8|SUP+SFT+9|SUP+SFT+0|  move app to workspace
// | SUP+1   | SUP+2   | SUP+3   | SUP+4   | SUP+5   | | SUP+6   | SUP+7   | SUP+8   | SUP+9   | SUP+0   |  switch to workspace
// | tmux 1  | tmux 2  | tmux 3  | tmux 4  | tmux 5  | | tmux 6  | tmux 7  | tmux 8  | tmux 9  | tmux 0  |  ctrl+space then N
//           |  GUI    |CTL+SFT+TAB|  SPC  | |  ENT  |CTRL+TAB |  ALT    |
// thumb outer keys: ctrl+alt+f (left) / ctrl+alt+n (right) -- switch user in Zen
// thumb second keys: ctrl+shift+tab (left, prev tab) / ctrl+tab (right, next tab)
// -- flip left/right if you'd rather have next on the left.
// thumb inner keys: left -> media_layer (editing/media/bluetooth), right ->
// back to default_layer.
                        bindings = <
   &kp LG(LS(N1)) &kp LG(LS(N2)) &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5))   &kp LG(LS(N6)) &kp LG(LS(N7)) &kp LG(LS(N8)) &kp LG(LS(N9)) &kp LG(LS(N0))
   &kp LG(N1)     &kp LG(N2)     &kp LG(N3)     &kp LG(N4)     &kp LG(N5)       &kp LG(N6)     &kp LG(N7)     &kp LG(N8)     &kp LG(N9)     &kp LG(N0)
   &tmux_win1     &tmux_win2     &tmux_win3     &tmux_win4     &tmux_win5       &tmux_win6     &tmux_win7     &tmux_win8     &tmux_win9     &tmux_win0
                    &kp LC(LA(F)) &kp LC(LS(TAB)) &to 4   &to 0 &kp LC(TAB) &kp LC(LA(N))
                        >;
                };

                media_layer {
// Reached from navigation_layer's left thumb. Left hand: editing keys
// (row 1) and clipboard/undo ops (row 2, same letters as their usual
// ctrl-shortcuts: Z X C V for undo/cut/copy/paste, plus redo). Right
// hand: media transport + volume (row 1), Bluetooth profile select
// (row 2) -- kept even though this build is wired, since nice_nano_v2
// also has BLE and this makes it easy to pair with another device
// later; drop it if you'd rather not carry the option. Row 3: F-keys,
// moved here from control_layer. Right thumb outer key left open --
// control_layer is hold-only now, so there's no &to target for it.
// -----------------------------------------------------------------
// | HOME| END | INS | DEL | BSPC|   |PREV | PLAY|NEXT |VOL- |VOL+  |
// |UNDO |CUT  |COPY |PASTE|REDO |   |BTCLR| BT1 | BT2 | BT3 | BT4  |
// |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10  |
//             | SYM | DEF | SPC |   | ENT | NAV |     |
                        bindings = <
   &kp HOME  &kp END  &kp INS  &kp DEL  &kp BSPC     &kp C_PREV &kp C_PP    &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP
   &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(LS(Z))   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
   &kp F1    &kp F2   &kp F3   &kp F4   &kp F5       &kp F6     &kp F7      &kp F8     &kp F9       &kp F10
                    &to 2 &to 0 &kp SPACE   &kp RET &to 3 &trans
                        >;
                };
        };
};

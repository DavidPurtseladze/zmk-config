#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        ht_left: ht_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <225>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 54 55 56 57>;
            flavor = "tap-preferred";
        };

        ht_right: ht_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53>;
        };

        ht_left_delay: ht_left_delay {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LEFT_DELAY";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <275>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 54 55 56 57>;
            flavor = "tap-preferred";
        };

        ht_right_delay: ht_right_delay {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_RIGHT_DELAY";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <275>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   =+  |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // |  CTRL |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   |   \   |
            //                     | LOWER|  GUI | ALT  |  SPACE |  | ENTER | RAISE| BSPC  | DEL   |

            bindings = <
&kp ESC           &kp N1                     &kp N2                     &kp N3                 &kp N4            &kp N5                         &kp N6         &kp N7             &kp N8                   &kp N9                       &kp N0                       &kp EQUAL
&kp TAB           &kp Q                      &kp W                      &kp F                  &kp P             &kp G                          &kp J          &kp L              &kp U                    &kp Y                        &kp SEMICOLON                &kp MINUS
&sk LEFT_SHIFT    &ht_left_delay LEFT_WIN A  &ht_left_delay LEFT_ALT R  &ht_left LEFT_SHIFT S  &ht_left LCTRL T  &kp D                          &kp H          &ht_right RCTRL N  &ht_right RIGHT_SHIFT E  &ht_right_delay RIGHT_ALT I  &ht_right_delay RIGHT_GUI O  &kp SQT
&kp LEFT_CONTROL  &kp Z                      &kp X                      &kp C                  &kp V             &kp B   &kp LBKT     &kp RBKT  &kp K          &kp M              &kp COMMA                &kp DOT                      &kp FSLH                     &kp BSLH
                                                                        &kp LEFT_WIN           &kp LEFT_ALT      &mo 2   &kp SPACE    &kp RET   &kp BACKSPACE  &mo 1              &kp DELETE
            >;
        };

        symbol {
            bindings = <
&trans  &kp PERCENT    &kp QUESTION          &kp HASH        &kp AT_SIGN       &kp EXCLAMATION                        &kp CARET     &kp UNDERSCORE     &kp ASTRK        &kp GRAVE              &kp TILDE         &trans
&trans  &kp NUMBER_5   &kp NUMBER_4          &kp NUMBER_3    &kp NUMBER_2      &kp NUMBER_1                           &kp NUMBER_6  &kp NUMBER_7       &kp NUMBER_8     &kp NUMBER_9           &kp NUMBER_0      &trans
&trans  &kp LESS_THAN  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE  &kp LBKT          &kp DOLLAR                             &kp EQUAL     &kp RBKT           &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp GREATER_THAN  &trans
&trans  &kp PLUS       &kp SEMICOLON         &kp SLASH       &kp SINGLE_QUOTE  &kp AMPERSAND    &kp COMMA    &kp DOT  &kp PIPE      &kp DOUBLE_QUOTES  &kp BSLH         &kp COLON              &kp MINUS         &trans
                                             &trans          &trans            &trans           &trans       &trans   &trans        &trans             &trans
            >;
        };

        numpad {
            bindings = <
&kp GRAVE  &kp END   &kp PAGE_UP   &kp PAGE_DOWN   &kp HOME         &trans                         &kp SLASH     &kp NUMBER_7  &kp NUMBER_8  &kp N9        &trans  &trans
&trans     &trans    &trans        &trans          &trans           &trans                         &kp ASTERISK  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans  &kp CAPSLOCK
&trans     &kp LEFT  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans                         &kp PLUS      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
&trans     &trans    &trans        &trans          &trans           &trans  &trans    &kp PERCENT  &kp MINUS     &kp EQUAL     &kp NUMBER_0  &kp DOT       &trans  &trans
                                   &trans          &trans           &trans  &trans    &trans       &trans        &trans        &trans
            >;
        };

        functional {
            bindings = <
&trans  &trans  &trans  &trans            &trans             &trans                               &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp F1  &kp F2  &kp F3  &kp F4            &kp F5             &kp F6                               &kp F7      &kp F8        &kp F9        &kp F10       &kp F11       &kp F12
&trans  &trans  &trans  &trans            &trans             &trans                               &trans      &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &trans    &trans  &bt BT_PRV  &bt BT_NXT    &trans        &trans        &trans        &trans
                        &trans            &trans             &trans             &trans    &trans  &trans      &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        functional_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

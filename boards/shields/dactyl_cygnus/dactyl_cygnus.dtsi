/*
 * Forked from ZMK mainline's `corne` shield (corne.dtsi), trimmed to the
 * "5 column" physical layout that Corne itself already ships as an
 * alternate option — 3 rows x 5 cols + 3 thumb keys per side = 36 keys,
 * which happens to match a Dactyl Cygnus 3x5+3 exactly. Reusing it means
 * we get a ready-made physical layout + matrix-transform for free instead
 * of hand-writing one.
 *
 * TODO: everything under kscan0 below is a PLACEHOLDER pin layout copied
 * from Corne's own wiring so this compiles out of the box. Replace
 * row-gpios here, and col-gpios in dactyl_cygnus_left.overlay /
 * dactyl_cygnus_right.overlay, with your actual soldered pins (nice!nano
 * pro_micro-numbered pins, matching your wiring diagram) before flashing.
 * See ../../../docs/dactyl-cygnus-build-notes.md.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <layouts/foostan/corne/5column.dtsi>

&foostan_corne_5col_layout {
    transform = <&five_column_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    five_column_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
// | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  |
// | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  |
// | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 |
//               | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)  RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)  RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)  RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                        RC(3,2) RC(3,3) RC(3,4)  RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row"; // TODO: confirm against your actual diode orientation

        // TODO PLACEHOLDER — replace with your real row wiring (4 rows:
        // 3 finger rows + 1 thumb row), shared by both halves.
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

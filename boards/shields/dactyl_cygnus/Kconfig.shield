#
# Forked from ZMK mainline's `corne` shield, trimmed from 6 to 5 columns
# per side to match a Dactyl Cygnus 3x5 + 3 thumb layout.

config SHIELD_DACTYL_CYGNUS_LEFT
    def_bool $(shields_list_contains,dactyl_cygnus_left)

config SHIELD_DACTYL_CYGNUS_RIGHT
    def_bool $(shields_list_contains,dactyl_cygnus_right)
